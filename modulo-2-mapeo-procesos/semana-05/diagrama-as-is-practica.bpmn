<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_1" name="Devolución de pedido (AS-IS)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Cliente" name="Cliente">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Atencion" name="Atención al cliente (manual)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bodega" name="Bodega">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finanzas" name="Finanzas">
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Cliente necesita devolver un pedido" />
    <bpmn:task id="T1" name="Solicitar devolución" />
    <bpmn:task id="T2" name="Recibir solicitud" />
    <bpmn:task id="T3" name="Verificar pedido y plazo" />
    <bpmn:exclusiveGateway id="GW1" name="¿Cumple política de devolución?" />
    <bpmn:task id="T5" name="Enviar instrucciones de devolución" />
    <bpmn:task id="T4" name="Notificar rechazo" />
    <bpmn:endEvent id="End_1" name="Solicitud rechazada" />
    <bpmn:task id="T6" name="Enviar producto a bodega" />
    <bpmn:task id="T7" name="Recibir producto" />
    <bpmn:task id="T8" name="Inspeccionar estado del producto" />
    <bpmn:exclusiveGateway id="GW2" name="¿Producto en buen estado?" />
    <bpmn:task id="T10" name="Notificar rechazo del reembolso" />
    <bpmn:endEvent id="End_2" name="Reembolso rechazado" />
    <bpmn:task id="T9" name="Procesar reembolso" />
    <bpmn:task id="T11" name="Notificar reembolso al cliente" />
    <bpmn:endEvent id="End_3" name="Devolución completada" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="GW1" />
